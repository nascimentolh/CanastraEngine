<ui>
    <column id="hud">
        <label class="hud-name" bind="world.character"/>
        <label class="hud-line" bind="world.detail" text=""/>
        <column class="gauges">
            <row class="gauge">
                <row class="fill cp" fills="world.cp"/>
                <label class="gauge-text" bind="world.cp-points" text=""/>
            </row>
            <row class="gauge">
                <row class="fill hp" fills="world.hp"/>
                <label class="gauge-text" bind="world.hp-points" text=""/>
            </row>
            <row class="gauge">
                <row class="fill mp" fills="world.mp"/>
                <label class="gauge-text" bind="world.mp-points" text=""/>
            </row>
        </column>
        <label class="hud-line" bind="app.status" text=""/>
    </column>
    <column id="chat">
        <column class="chat-log" repeat="chat">
            <label class="chat-line" bind="item.text" text=""/>
        </column>
        <input class="chat-line-input" bind="chat.line" action="say" placeholder="Press Enter to speak"/>
    </column>
    <row id="target-dock" show="target.shown">
        <column id="target">
            <label class="target-name" bind="target.name" text=""/>
            <row class="gauge">
                <row class="fill hp" fills="target.hp"/>
                <label class="gauge-text" bind="target.hp-points" text=""/>
            </row>
            <label class="target-line" bind="target.detail" text=""/>
        </column>
    </row>
    <label id="version" bind="app.version" text="?"/>
</ui>
