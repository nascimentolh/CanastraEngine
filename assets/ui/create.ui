<ui>
    <window id="create">
        <label class="heading" text="Create Character"/>
        <row class="field">
            <label class="caption" text="Name"/>
            <input bind="create.name" placeholder="Character name" action="confirm"/>
        </row>
        <row class="field">
            <label class="caption" text="Race"/>
            <select bind="create.race" options="races" action="race:{index}"/>
        </row>
        <row class="field">
            <label class="caption" text="Class"/>
            <select bind="create.class" options="classes" action="class:{index}"/>
        </row>
        <row class="field">
            <label class="caption" text="Gender"/>
            <select bind="create.gender" options="genders" action="gender:{index}"/>
        </row>
        <row class="field">
            <label class="caption" text="Hairstyle"/>
            <row class="stepper">
                <button class="step" text="&#8249;" action="hair.prev"/>
                <label class="step-value" bind="create.hair"/>
                <button class="step" text="&#8250;" action="hair.next"/>
            </row>
        </row>
        <row class="field">
            <label class="caption" text="Hair Color"/>
            <row class="stepper">
                <button class="step" text="&#8249;" action="color.prev"/>
                <label class="step-value" bind="create.color"/>
                <button class="step" text="&#8250;" action="color.next"/>
            </row>
        </row>
        <row class="field">
            <label class="caption" text="Face"/>
            <row class="stepper">
                <button class="step" text="&#8249;" action="face.prev"/>
                <label class="step-value" bind="create.face"/>
                <button class="step" text="&#8250;" action="face.next"/>
            </row>
        </row>
        <column class="info">
            <label class="info-title" bind="create.class"/>
            <label class="info-line" bind="create.body"/>
            <label class="info-line" bind="create.mind"/>
        </column>
        <label class="status" bind="app.status" text=""/>
        <row class="actions centered">
            <button class="primary" text="Create" action="confirm"/>
            <button text="Cancel" action="cancel"/>
        </row>
    </window>
    <row id="view">
        <button class="view-button" bind="create.zoom" text="+" action="zoom"/>
    </row>
    <label id="version" bind="app.version" text="?"/>
</ui>
