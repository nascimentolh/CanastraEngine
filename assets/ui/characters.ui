<ui>
    <column id="selected">
        <label class="selected-name" bind="selected.name"/>
        <label class="selected-line" bind="selected.class"/>
        <label class="selected-line" bind="selected.level"/>
    </column>
    <column id="dock">
        <label class="status" bind="app.status" text=""/>
        <button id="enter" class="primary" text="Enter World" action="start"/>
        <row class="cards">
            <row class="cards" repeat="characters">
                <column class="card" checked="item.selected" action="select:{index}">
                    <label class="card-name" bind="item.name"/>
                    <label class="card-line" bind="item.detail"/>
                </column>
            </row>
            <column class="card" action="create">
                <label class="card-plus" text="+"/>
                <label class="card-line" text="Create"/>
            </column>
        </row>
    </column>
    <button id="back" text="Back" action="back"/>
    <button id="delete" text="Delete" action="delete"/>
    <label id="version" bind="app.version" text="?"/>
</ui>
