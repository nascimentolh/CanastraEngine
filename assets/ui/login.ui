<ui>
    <window id="login">
        <label class="title" text="CANASTRA"/>
        <label class="subtitle" text="LINEAGE II · HIGH FIVE"/>
        <label class="status" bind="app.status" text=""/>
        <row class="actions">
            <button class="primary" text="Login" action="login"/>
            <button text="Exit" action="exit"/>
        </row>
    </window>
    <label id="version" bind="app.version" text="?"/>
</ui>
