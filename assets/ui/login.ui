<ui>
    <window id="login">
        <column class="field">
            <label class="caption" text="ACCOUNT"/>
            <input bind="login.account" placeholder="Your account name"/>
        </column>
        <column class="field">
            <label class="caption" text="PASSWORD"/>
            <input bind="login.password" type="password" placeholder="Your password" action="login"/>
        </column>
        <label class="status" bind="app.status" text=""/>
        <button class="primary" text="LOG IN" action="login"/>
        <button class="quiet" text="Exit game" action="exit"/>
    </window>
    <label id="version" bind="app.version" text="?"/>
</ui>
